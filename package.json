      "optional": true
    }
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.0.0"
  },
  "optionalDependencies": {
    "naive-ui": "^2.0.0",
    "primevue": "^4.0.0"
  }
